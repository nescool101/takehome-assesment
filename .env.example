# OPTIONAL: every value below has the same default in code, so the app runs without a .env file.
# To override: cp .env.example .env, edit, then `set -a; . ./.env; set +a` (local java/mvn);
# docker compose also reads ../.env when it exists.
# Non-secret config only; real secrets go through agent-vault placeholders.
# Scenario presets (override any value below individually)
SCENARIO=MID            # OPTIMISTIC | MID | PESSIMISTIC  (scale + downstream capacity)
BUDGET=MID              # OPTIMISTIC=10000 | MID=3000 | PESSIMISTIC=1000 USD/month
BUDGET_TIER=TARGET      # LEAN | TARGET | CAP

# Scale overrides (blank = use SCENARIO default)
FIRMS=
ACTIVE_ENGAGEMENTS=
PRODUCTS=40
MEDIAN_ENGAGEMENTS_PER_FIRM=40
MAX_ENGAGEMENTS_PER_FIRM=40000
ENGAGEMENT_LOAD_SECONDS=60
PUBLISH_CADENCE_DAYS=7
DOWNSTREAM_PERMITS=
ENUMERATION_COVERAGE=    # 0..1 share of engagement IDs listable without loading (version read still needs the 1 min load)
BUDGET_CAP_USD=

# Worker
RETRY_MAX_ATTEMPTS=3
BREAKER_FAILURES=5       # consecutive retryable failures that open the circuit breaker
BREAKER_COOLDOWN_MS=5000 # how long it stays open
DEFER_DELAY_MS=1000      # how long a deferred job (firm cap, breaker open, in progress) waits
SQS_VISIBILITY_TIMEOUT_SECONDS=300   # applied to the queue at startup; the idempotency lease is 2x this
ADMIN_TOKEN=             # /admin/* needs header x-admin-token; REQUIRED on real AWS (unset is only open when AWS_ENDPOINT_URL is set)
CORS_ORIGIN=             # allowed browser origin; unset = "*" on LocalStack, none on real AWS
SIM_LATENCY_MS=100       # downstream stub latency in ms (real call = ENGAGEMENT_LOAD_SECONDS); locust/run.sh uses 300
REGION_NAME=us           # which regional stack this process serves: queue <name>-fanout, tables <name>-*
PORT=8080                # ops API port

# AWS / LocalStack (dummy creds, not secrets)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
REGIONS=us-east-1,eu-west-1,ca-central-1

# Cache (in-process TTL cache for the "is this offer withdrawn?" read; default off so results can be compared on vs off)
CACHE_ENABLED=false
CACHE_TTL_SECONDS=5      # a withdrawal reaches a running worker up to this late

# Load sim (locust/)
SCALE=100                # engagement counts divided by this (giant firm 40000 -> 400 jobs)
OTHER_FIRMS=10           # median-size firms in each publish burst

# Secrets (future LLM summary polish): written via `agent-vault write`
# LLM_API_KEY=<agent-vault:llm-api-key>
